// Pipeline-from-SCM: trusted integration repo, private OpenClaw source checkout.
// The owner installs the git credential and the independent deployment helper.
pipeline {
  agent { label 'local-docker' }
  options {
    timestamps()
    disableConcurrentBuilds()
    skipDefaultCheckout(true)
    timeout(time: 90, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '20'))
  }
  environment {
    OPENCLAW_DEPLOY_ROOT = '/home/motuariki/Documents/DockerVolumes/openclaw/deploy'
  }
  stages {
    stage('Checkout integration and gateway source') {
      steps {
        checkout scm
        dir('gateway-source') {
          script {
            def revision = checkout([$class: 'GitSCM', branches: [[name: '*/main']],
              userRemoteConfigs: [[url: 'https://git.trance-0.com/Trance-0/openclaw.git', credentialsId: 'agent-git-read']]])
            env.OPENCLAW_REVISION = revision.GIT_COMMIT
            env.OPENCLAW_IMAGE = "openclaw:source-${revision.GIT_COMMIT}"
            env.OPENCLAW_CI_IMAGE = "openclaw-ci:${revision.GIT_COMMIT}"
          }
        }
      }
    }
    stage('Build and focused gateway checks') {
      steps {
        dir('gateway-source') {
          sh '''
            set -eu
            docker buildx build --builder pcp-jenkins --load --progress=plain --target build \
              --label org.opencontainers.image.revision="$OPENCLAW_REVISION" -t "$OPENCLAW_CI_IMAGE" .
            docker run --rm --memory=6g --cpus=4 "$OPENCLAW_CI_IMAGE" pnpm exec tsc -p tsconfig.plugin-sdk.dts.json --noEmit --emitDeclarationOnly false
            docker run --rm --memory=6g --cpus=4 "$OPENCLAW_CI_IMAGE" pnpm exec vitest run \
              src/agents/transcript-policy.test.ts src/agents/subagent-announce-delivery.test.ts \
              src/agents/subagent-announcement-result.test.ts src/auto-reply/reply/dispatch-acp-delivery.test.ts
            docker run --rm --memory=6g --cpus=4 "$OPENCLAW_CI_IMAGE" pnpm exec vitest run \
              src/commands/agent.test.ts -t 'uses default fallback list'
          '''
        }
        sh 'docker run --rm --network none -v "$PWD/opencode/openclaw-plugin:/src:ro" -w /src node:22-alpine node --test runtime.test.js'
      }
    }
    stage('Build immutable runtime') {
      steps {
        dir('gateway-source') {
          sh '''
            set -eu
            docker buildx build --builder pcp-jenkins --load --progress=plain \
              --build-arg OPENCLAW_DOCKER_APT_PACKAGES=python3 \
              --label org.opencontainers.image.revision="$OPENCLAW_REVISION" -t "$OPENCLAW_IMAGE" .
            docker image inspect -f '{{.Id}}' "$OPENCLAW_IMAGE" > image-digest.txt
          '''
          archiveArtifacts artifacts: 'image-digest.txt', fingerprint: true
        }
      }
    }
    stage('Deploy and promote known-good image') {
      steps {
        sh 'python3 opencode/scripts/install-harness.py --gateway-only --state-root /home/motuariki/Documents/DockerVolumes/openclaw/state --server-root /home/motuariki/Documents/DockerVolumes/openclaw-opencode'
        // Recovery code is installed independently outside the agent checkout.
        sh '''
          set -eu
          python3 "$OPENCLAW_DEPLOY_ROOT/openclaw-release.py" --root "$OPENCLAW_DEPLOY_ROOT" \
            deploy --image "$OPENCLAW_IMAGE" --revision "$OPENCLAW_REVISION" --soak 60
        '''
      }
    }
  }
}
