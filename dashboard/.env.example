# Agent dashboard configuration. Copy to `.env` and fill in real values.
# `.env` is gitignored — never commit secrets.

# --- Server ---
# Bind to loopback only. The port bind is also the single-instance lock.
HOST=127.0.0.1
PORT=14141
# Bearer token required by every mutating endpoint (any local process can reach loopback).
DASHBOARD_TOKEN=change-me-dashboard-token
# Secret used to sign the session cookie.
SESSION_SECRET=change-me-session-secret

# --- OIDC (Casdoor @ auth.trance-0.com) ---
# Copy the Gitea OIDC app in Casdoor and rename its group from
# `trance-0/app-gitea` to `trance-0/app-agent`.
OIDC_ISSUER=https://auth.trance-0.com
OIDC_CLIENT_ID=agent-dashboard
OIDC_CLIENT_SECRET=change-me-client-secret
OIDC_REDIRECT_URI=http://127.0.0.1:14141/auth/callback
# Members must hold this Casdoor group to sign in.
OIDC_REQUIRED_GROUP=trance-0/app-agent

# --- OpenClaw gateway ---
OPENCLAW_ENDPOINT=http://127.0.0.1:18789
OPENCLAW_TOKEN=change-me-openclaw-gateway-token

# --- AstrBot (QQ/WeChat adapter) ---
ASTRBOT_ENDPOINT=http://127.0.0.1:6185
ASTRBOT_USERNAME=admin
ASTRBOT_PASSWORD=change-me-astrbot-password

# --- Jenkins (read-only build status) ---
JENKINS_ENDPOINT=http://127.0.0.1:8081
JENKINS_USER=agent
JENKINS_TOKEN=change-me-jenkins-token
